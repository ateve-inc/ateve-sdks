{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "globalDependencies": [
    "tools/codegen/src/toolchain.ts",
    "packages/contract/fixtures/**",
    "pyproject.toml",
    "uv.lock"
  ],
  "globalEnv": ["ATEVE_TOOLCHAIN", "UV_PYTHON", "JAVA_HOME", "MAVEN_OPTS"],
  "tasks": {
    "//#format": {
      "cache": false,
      "outputs": []
    },
    "//#format:check": {
      "cache": false,
      "outputs": []
    },
    "build": {
      "outputs": ["dist/**", "target/**", "!target/surefire-reports/**", "!target/maven-status/**"]
    },
    "@ateve/codegen#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/contract/openapi.json",
        "$TURBO_ROOT$/packages/contract/bindings.json"
      ],
      "outputs": ["generated/**"]
    },
    "generate": {
      "dependsOn": ["@ateve/codegen#build"],
      "inputs": ["package.json"],
      "outputs": [
        ".generated-models.json",
        "src/types.ts",
        "src/ateve/models.py",
        "src/ateve/_model_exports.py",
        "src/main/java/ai/ateve/models/**"
      ]
    },
    "generate:check": {
      "description": "Validate the contract and compare committed models without writing files",
      "dependsOn": ["@ateve/contract#lint"],
      "cache": false
    },
    "@ateve/contract#lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tools/codegen/src/**"],
      "outputs": []
    },
    "@ateve/codegen#typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/contract/*.ts"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "test": {
      "cache": false
    },
    "@ateve/java#build": {
      "dependsOn": ["test"],
      "outputs": ["target/**", "!target/surefire-reports/**", "!target/maven-status/**"]
    },
    "ateve#generate": {
      "dependsOn": ["@ateve/codegen#build"],
      "command": ["node", "../../tools/codegen/src/cli.ts", "sync", "python"],
      "inputs": ["pyproject.toml"],
      "outputs": [".generated-models.json", "src/ateve/models.py", "src/ateve/_model_exports.py"]
    },
    "ateve#typecheck": {
      "dependsOn": ["check"],
      "outputs": []
    },
    "ateve#build": {
      "command": ["uv", "build", "--no-build-isolation", "--package", "ateve", "--out-dir", "dist"],
      "cache": true,
      "outputs": ["dist/**"]
    },
    "ateve#check": {
      "command": ["uv", "run", "--locked", "--package", "ateve", "mypy"],
      "outputs": []
    }
  },
  "futureFlags": {
    "experimentalPythonWorkspaces": true,
    "experimentalTaskCommand": true
  },
  "globalPassThroughEnv": ["UV_CACHE_DIR"]
}
