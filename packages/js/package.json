{
  "name": "@ateve/js",
  "version": "0.1.0",
  "description": "Official JavaScript and TypeScript SDK for the Ateve Search API",
  "keywords": [
    "AI",
    "RAG",
    "ateve",
    "search"
  ],
  "homepage": "https://ateve.ai",
  "bugs": {
    "url": "https://github.com/ateve-inc/ateve-sdks/issues"
  },
  "license": "Apache-2.0",
  "author": "Ateve Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/ateve-inc/ateve-sdks.git",
    "directory": "packages/js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "name": "ateve",
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ../../tools/codegen/src/versions.ts && node ../../tools/codegen/src/cli.ts check && npm run lint && npm run typecheck && npm test && npm run build",
    "lint": "oxlint --max-warnings=0 src test tsup.config.ts",
    "generate": "node ../../tools/codegen/src/cli.ts sync js"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "oxlint": "^1.87.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
