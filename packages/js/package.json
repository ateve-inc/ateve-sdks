{
  "name": "@ateve/js",
  "version": "0.2.0",
  "description": "Official JavaScript and TypeScript SDK for the Ateve Search API",
  "keywords": [
    "AI",
    "RAG",
    "ateve",
    "search"
  ],
  "homepage": "https://ateve.ai",
  "bugs": {
    "url": "https://github.com/ateve-inc/ateve-sdks/issues"
  },
  "license": "Apache-2.0",
  "author": "Ateve Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/ateve-inc/ateve-sdks.git",
    "directory": "packages/js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "name": "ateve",
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ../../tools/codegen/src/versions.ts && node ../../tools/codegen/src/cli.ts check && npm run lint && npm run typecheck && npm test && npm run build",
    "lint": "oxlint --max-warnings=0 src test tsdown.config.mts",
    "generate": "node ../../tools/codegen/src/cli.ts sync js"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "ofetch": "2.0.0-alpha.3",
    "oxlint": "^1.89.0",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
