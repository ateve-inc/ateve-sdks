{
  "openapi": "3.1.0",
  "info": {
    "title": "Ateve Search API — SDK contract",
    "version": "0.2.1",
    "description": "Search request and response models aligned with live API probes on October 9, 2026 and the October 26, 2026 highlights update. Response text uses the text field for both plain text and Markdown, and may be null when extraction fails."
  },
  "servers": [
    {
      "url": "https://api.ateve.ai"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ContentFormat": {
        "type": "string",
        "enum": ["text", "markdown"],
        "description": "Format of text in search results."
      },
      "UserLocation": {
        "type": "object",
        "description": "UserLocation model for POST /v1/search.",
        "x-sdk-kind": "request",
        "properties": {
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "region": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "timezone": {
            "type": "string",
            "description": "IANA time zone; each SDK retains its existing platform validation."
          }
        },
        "additionalProperties": false
      },
      "LocaleSettings": {
        "type": "object",
        "description": "LocaleSettings model for POST /v1/search.",
        "x-sdk-kind": "request",
        "properties": {
          "mkt": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2}$"
          },
          "user_location": {
            "$ref": "#/components/schemas/UserLocation"
          }
        },
        "additionalProperties": false
      },
      "TextOptions": {
        "type": "object",
        "description": "Options for retrieving full text. Passing an empty object enables text with server defaults.",
        "x-sdk-kind": "request",
        "properties": {
          "max_characters": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647,
            "description": "Per-result text character limit after format conversion; server default 5000."
          },
          "format": {
            "$ref": "#/components/schemas/ContentFormat",
            "default": "text"
          }
        },
        "additionalProperties": false
      },
      "ContentOptions": {
        "type": "object",
        "description": "ContentOptions model for POST /v1/search.",
        "x-sdk-kind": "request",
        "properties": {
          "snippet": {
            "type": "boolean",
            "default": true
          },
          "highlights": {
            "type": "boolean",
            "default": false,
            "description": "Enable query-relevant excerpts that directly support answers, reducing unrelated information compared with snippets."
          },
          "text": {
            "$ref": "#/components/schemas/TextOptions"
          },
          "favicon": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "SearchRequest": {
        "type": "object",
        "description": "SearchRequest model for POST /v1/search.",
        "x-sdk-kind": "request",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "max_results": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 10
          },
          "date_range": {
            "type": "string",
            "description": "day, week, month, year, YYYY-MM-DD, or open/closed YYYY-MM-DD..YYYY-MM-DD range; empty input retains current SDK behavior."
          },
          "locale": {
            "$ref": "#/components/schemas/LocaleSettings"
          },
          "include_domains": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 300
          },
          "exclude_domains": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 300
          },
          "content": {
            "$ref": "#/components/schemas/ContentOptions"
          },
          "safe_search": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "required": ["query"]
      },
      "ImageItem": {
        "type": "object",
        "description": "ImageItem model for POST /v1/search.",
        "x-sdk-kind": "response",
        "properties": {
          "url": {
            "type": "string"
          },
          "width": {
            "type": ["integer", "null"]
          },
          "height": {
            "type": ["integer", "null"]
          },
          "alt": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": true,
        "required": ["url", "width", "height", "alt"]
      },
      "QueryInfo": {
        "type": "object",
        "description": "QueryInfo model for POST /v1/search.",
        "x-sdk-kind": "response",
        "properties": {
          "original": {
            "type": "string",
            "description": "The submitted search query."
          }
        },
        "additionalProperties": true,
        "required": ["original"]
      },
      "SearchResult": {
        "type": "object",
        "description": "SearchResult model for POST /v1/search.",
        "x-sdk-kind": "response",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "display_url": {
            "type": "string"
          },
          "published_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "score": {
            "type": "number"
          },
          "snippet": {
            "type": "string",
            "description": "Excerpt returned by default, including alongside text; omitted when content.snippet is false."
          },
          "highlights": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Query-relevant excerpts that directly support answers, returned alongside snippet when content.highlights is true."
          },
          "text": {
            "type": ["string", "null"],
            "description": "Extracted content when content.text is requested, in the selected text or Markdown format. Null when extraction fails; omitted when text is not requested."
          },
          "favicon": {
            "type": "string"
          },
          "images": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImageItem"
            }
          },
          "is_safe": {
            "type": ["boolean", "null"]
          }
        },
        "additionalProperties": true,
        "required": ["images"]
      },
      "SearchResponse": {
        "type": "object",
        "description": "SearchResponse model for POST /v1/search.",
        "x-sdk-kind": "response",
        "properties": {
          "id": {
            "type": "string"
          },
          "created": {
            "type": "integer",
            "format": "int64"
          },
          "latency_ms": {
            "type": "integer"
          },
          "query": {
            "$ref": "#/components/schemas/QueryInfo"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchResult"
            }
          },
          "total_estimated_matches": {
            "type": ["integer", "null"],
            "format": "int64",
            "description": "Estimated matches returned by the server; may exceed the number of results in this response."
          }
        },
        "additionalProperties": true,
        "required": ["id", "created", "latency_ms", "query", "results"]
      },
      "ErrorDetail": {
        "type": "object",
        "description": "Structured API error metadata.",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "param": {
            "type": "string"
          },
          "doc_url": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "ErrorResponse": {
        "type": "object",
        "description": "API error envelope.",
        "properties": {
          "id": {
            "type": "string"
          },
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "paths": {
    "/v1/search": {
      "post": {
        "operationId": "search",
        "summary": "Execute one search without automatic retries.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Search result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Authentication error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "402": {
            "description": "Payment required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Permission or billing error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              },
              "Retry-After": {
                "description": "Seconds or HTTP date; surfaced as a hint without retrying.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
